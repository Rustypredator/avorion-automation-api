# The directory holding the moddata/ folder the mod writes into. Usually the galaxy
# folder - but not always, so do not guess it. The mod prints the transport directory it
# settled on to the server console at startup:
#
#   AutomationAPI: ... transport directory: ./moddata/AutomationAPI
#
# GALAXY_DIR is that path with /moddata/AutomationAPI taken off the end. A relative path
# there is relative to the Avorion server's own working directory; if the game server runs
# in a container of its own, GALAXY_DIR is the host path of the volume that directory
# lives on.
#
# Start the game server before this stack. The mod creates and owns these directories, and
# if they are missing when the container starts, Docker manufactures them as root instead.
# The bridge then answers every call with transport_not_writable.
GALAXY_DIR=/home/avorion/.avorion/galaxies/defaultgalaxy

# A hostname that resolves to this machine turns on automatic HTTPS. Leave it unset
# for plain HTTP on HTTP_PORT.
#API_DOMAIN=avorion.example.com

# uid:gid of the account the Avorion server runs as, so request files are owned by it.
# Leaving this unset runs the container as root, which also works - root ignores the
# permissions either way. If you do set it, the transport directory has to belong to that
# account, which it will as long as the mod was the one that created it. Numeric only:
# the container has no account for the host's names.
#BRIDGE_USER=1000:1000

#HTTP_PORT=80
#HTTPS_PORT=443

# Which origin the browser console - or any other browser page - may call the API from.
# "*" is the default and is safe: the key travels in a header, never a cookie, so a
# browser sends no credential of its own and a hostile page reaches no more than curl
# already does. Narrow it to one origin, or set it empty to send no CORS headers at all.
# The bundled console is served from the API itself at /console/, so it is same-origin
# and works regardless of this setting.
#CORS_ORIGIN=*

# The bridge keeps its own durable copy of where craft have been and what they did, built
# out of the answers it relays - the mod's log is 200 events per ship in server memory and
# is gone at the next restart. It lives in the "history" named volume; set HISTORY_DIR to
# an empty string to keep none at all, and HISTORY_DAYS to change how far back it goes.
#
# It records while something is calling the API, so a gap in it is a gap in who was
# looking. Read it at /history/summary, /history/visits, /history/heatmap and
# /history/events.
#HISTORY_DIR=/history
#HISTORY_DAYS=30
