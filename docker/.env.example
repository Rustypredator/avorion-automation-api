# The directory holding the moddata/ folder the mod writes into. Usually the galaxy
# folder - but not always, so do not guess it. The mod prints the transport directory it
# settled on to the server console at startup:
#
#   AutomationAPI: ... transport directory: ./moddata/AutomationAPI
#
# GALAXY_DIR is that path with /moddata/AutomationAPI taken off the end. A relative path
# there is relative to the Avorion server's own working directory; if the game server runs
# in a container of its own, GALAXY_DIR is the host path of the volume that directory
# lives on.
#
# Start the game server before this stack. The mod creates and owns these directories, and
# if they are missing when the container starts, Docker manufactures them as root instead.
# The bridge then answers every call with transport_not_writable.
GALAXY_DIR=/home/avorion/.avorion/galaxies/defaultgalaxy

# A hostname that resolves to this machine turns on automatic HTTPS. Leave it unset
# for plain HTTP on HTTP_PORT.
#API_DOMAIN=avorion.example.com

# uid:gid of the account the Avorion server runs as, so request files are owned by it.
# Leaving this unset runs the container as root, which also works - root ignores the
# permissions either way. If you do set it, the transport directory has to belong to that
# account, which it will as long as the mod was the one that created it. Numeric only:
# the container has no account for the host's names.
#BRIDGE_USER=1000:1000

#HTTP_PORT=80
#HTTPS_PORT=443

# Which origin the browser console - or any other browser page - may call the API from.
# "*" is the default and is safe: the key travels in a header, never a cookie, so a
# browser sends no credential of its own and a hostile page reaches no more than curl
# already does. Narrow it to one origin, or set it empty to send no CORS headers at all.
# The bundled console is served from the API itself at /console/, so it is same-origin
# and works regardless of this setting.
#CORS_ORIGIN=*

# The bridge keeps its own durable copy of where craft have been and what they did, built
# out of the answers it relays - the mod's log is 200 events per ship in server memory and
# is gone at the next restart. It lives in Postgres, in the "history" named volume. Read it
# at /history/summary, /history/visits, /history/heatmap and /history/events, and the
# station economy at /history/economy/summary, /history/economy/series and
# /history/economy/goods.
#
# The password is the one setting with no default, because there is no safe one to pick.
# Any value works - nothing outside the compose network can reach the database, which
# publishes no host port - so generate one and forget it:
#
#   openssl rand -hex 24
#
# Changing it later does NOT change the password Postgres already initialised the volume
# with; either change it with ALTER ROLE or delete the volume and lose the history.
POSTGRES_PASSWORD=

#POSTGRES_DB=avorion
#POSTGRES_USER=avorion

# How far back the history goes. Rows older than this are deleted by the poller on its
# hourly pass.
#HISTORY_DAYS=30

# Blanking this keeps no history at all: the bridge then relays every call exactly as it
# always did and answers 404 on /history. The db service still starts, so stop it too with
# `docker compose stop db poller` if you want it gone.
#
# The switch is here rather than on HISTORY_DSN because compose expands a variable this
# file never mentions to an empty string, so an empty DSN cannot be told apart from an
# absent one. This has a default to fall back to, so blank here is unambiguous.
#HISTORY_DB_HOST=db

# Point the bridge at a Postgres you already run, instead of the db service. Overrides the
# host, port and database name above; the user and password are still taken from
# POSTGRES_USER and POSTGRES_PASSWORD.
#HISTORY_DSN=pgsql:host=db.example.com;port=5432;dbname=avorion

# #### The poller #### --
#
# Nothing in the mod pushes. Movement is only recorded when something asks for /ships, and
# the mod's event ring buffer drops its oldest entry whether or not anyone collected it -
# so without a poller the history is a record of when a browser tab happened to be open.
#
# POLL_KEYS is a comma-separated list of the API keys whose fleets should be recorded. It
# is the one place in this deployment that holds a credential at rest, because the poller
# has to authenticate like any other client - the bridge itself stores only a hash and
# cannot recover a key. Keep this file readable by root only.
#
# With it empty the poller logs that it has nothing to do and exits; everything else keeps
# working, and history is still recorded whenever you have the console open.
#POLL_KEYS=avo_xxxxxxxx,avo_yyyyyyyy

# Seconds between passes. This is the accuracy of a travel track - a craft that crosses a
# sector between two passes looks like it went straight there - and it has to be short
# enough that no ship generates 200 events between passes, or the overflow is lost. Every
# pass costs one file round-trip through the mod per key, plus one per craft, and that work
# happens on the game server's own tick.
#POLL_INTERVAL=30

# Set to 0 to record movement only and skip the per-craft event calls, which is most of
# the transport traffic on a large fleet.
#POLL_EVENTS=1

# Set to 0 to skip the calls the station economy is built from - /stations and /economy,
# both with owner=all, and the stations' trade and production feed at /economy/events.
# They are a few round trips per pass whatever the fleet looks like, so leaving this on
# costs far less than POLL_EVENTS does. With it off, the measured rates in the console's
# Industry view only cover what the mod has recorded since the server last started.
#POLL_ECONOMY=1

# The floor, in seconds, between two stored samples of the same station's books. The
# poller keeps calling at POLL_INTERVAL either way - so a console that is open still shows
# live numbers - and only the durable copy is thinned.
#
# There is nothing to gain from lowering it much. The mod reads a station's earnings out
# of the craft's database row, and the game rewrites that row when it saves or unloads the
# sector, so a sample taken a few seconds after the last one is a copy of it. Raising it
# trades resolution for rows: at the default, one station is about 290 rows a day.
#HISTORY_ECONOMY_INTERVAL=300
