# Where this machine keeps the game and the test galaxy, for tools/localserver.sh.
#
#   cp tools/local.env.example tools/local.env
#
# tools/local.env is gitignored: the paths are yours, not the repo's. See
# docs/local-testing.md for the whole process.

# The Avorion install - the directory holding bin/AvorionServer and server.sh.
AVORION_DIR="$HOME/.steam/steam/steamapps/common/Avorion"

# The galaxy is [GALAXY_DATAPATH]/[GALAXY_NAME]. Use a galaxy of its own for testing: the
# boss lab spawns ships and bosses into it, and dev commands are enabled there.
GALAXY_DATAPATH="$HOME/.avorion/galaxies"
GALAXY_NAME="apitest"

# Your player index in that galaxy (players/player_<index>.dat), for the /run helpers.
PLAYER_INDEX=1

# An API key for that player, once you have one - /apikey new in game, or
# `tools/localserver.sh key` with the server running. Only ever for the test galaxy.
API_KEY=""

# Where the docker stack answers, for the curl examples in docs/local-testing.md.
API_URL="https://localhost"
